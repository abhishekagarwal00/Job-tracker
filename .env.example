# Copy this file to .env and fill in your own values

# MongoDB connection string.
# Local:  mongodb://127.0.0.1:27017/job-tracker
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/job-tracker
MONGO_URI=mongodb://127.0.0.1:27017/job-tracker

# Port the Express server listens on
PORT=4000

# Comma-separated search keywords used when pulling from job APIs
JOB_KEYWORDS=software engineer,backend developer,full stack developer

# Comma-separated locations passed to job APIs that support location filters
JOB_LOCATIONS=remote,india

# How often (cron syntax) the auto-fetch job runs. Default: every 6 hours.
FETCH_CRON=0 */6 * * *
